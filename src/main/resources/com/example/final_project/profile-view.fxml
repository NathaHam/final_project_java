<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="550" prefWidth="700" style="-fx-background-color: #172C24;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.final_project.ProfileController">

    <top>
        <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #203B30;">

            <padding>
                <Insets bottom="20" top="20" />
            </padding>
            <Label style="-fx-font-size: 27px; -fx-font-weight: bold; -fx-text-fill: #F5E9CD;" text="PLAYER PROFILE" />
            <Label style="-fx-text-fill: #C6A45D;" text="Welcome to Java Chess" />
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets bottom="25" left="40" right="40" top="25" />
            </padding>
            <Label fx:id="lblUsername" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;" text="Username" />
            <Label fx:id="lblPlayerId" style="-fx-text-fill: #C6A45D;" text="Player ID:" />
            <Label fx:id="lblDateCreated" style="-fx-text-fill: white;" text="Date Created:" />
            <GridPane hgap="15" vgap="15">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" />
                    <ColumnConstraints percentWidth="50" />
                </columnConstraints>
                <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #294136; -fx-background-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <padding>
                        <Insets bottom="18" top="18" />
                    </padding>
                    <Label fx:id="lblGames" style="-fx-font-size: 30px; -fx-text-fill: #C6A45D;" text="0" />
                    <Label style="-fx-text-fill: white;" text="Games Played" />
                </VBox>
                <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #294136; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <padding>
                        <Insets bottom="18" top="18" />
                    </padding>
                    <Label fx:id="lblWins" style="-fx-font-size: 30px; -fx-text-fill: #C6A45D;" text="0" />
                    <Label style="-fx-text-fill: white;" text="Wins" />
                </VBox>
                <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #294136; -fx-background-radius: 8;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <padding>
                        <Insets bottom="18" top="18" />
                    </padding>
                    <Label fx:id="lblLosses" style="-fx-font-size: 30px; -fx-text-fill: #C6A45D;" text="0" />
                    <Label style="-fx-text-fill: white;" text="Losses" />
                </VBox>
                <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #294136; -fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <padding>
                        <Insets bottom="18" top="18" />
                    </padding>
                    <Label fx:id="lblDraws" style="-fx-font-size: 30px; -fx-text-fill: #C6A45D;" text="0" />
                    <Label style="-fx-text-fill: white;" text="Draws" />
                </VBox>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>
            <Label fx:id="lblWinPercentage" style="-fx-text-fill: #C6A45D; -fx-font-size: 16px;" text="Win Percentage: 0%" />
            <HBox alignment="CENTER" spacing="20">
                <Button onAction="#playChess" prefHeight="42" prefWidth="170" style="-fx-background-color: #C6A45D; -fx-text-fill: #172C24; -fx-font-weight: bold;" text="PLAY CHESS" />
                <Button onAction="#logout" prefHeight="42" prefWidth="120" style="-fx-background-color: transparent; -fx-border-color: #C6A45D; -fx-border-radius: 5; -fx-text-fill: white;" text="LOGOUT" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
